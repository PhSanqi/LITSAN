{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "allowJs": true,
    "types": ["node"],
    "composite": true,
    "tsBuildInfoFile": ".tsbuild/shell.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.mjs"],
  "exclude": ["node_modules", "dist", "src/contracts", "src/core", "src/archify"],
  "references": [
    { "path": "./src/contracts" },
    { "path": "./src/core" },
    { "path": "./src/archify" }
  ]
}
