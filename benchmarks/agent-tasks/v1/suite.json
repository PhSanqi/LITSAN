{
  "name": "Memhub Real Agent Task Arena v1",
  "version": "real-agent-task-arena-v1",
  "description": "Deterministic end-to-end coding tasks for measuring whether memory improves actual agent delivery. Primary outcomes come from hidden functional/diff/architecture/stale checks, not an LLM judge.",
  "categories": {
    "interrupted_resume": "Resume interrupted work using durable handoff/current truth.",
    "stale_decision": "Prefer current decisions over superseded history.",
    "project_isolation": "Modify only the intended project/account/client scope.",
    "architecture_constraint": "Complete work without violating durable architecture constraints.",
    "provenance_debug": "Use prior reproduction/root-cause evidence to fix a regression.",
    "cross_session_handoff": "Carry an agreed contract from design/review into implementation."
  },
  "primary_metrics": [
    "task_completion_rate",
    "hidden_check_pass_rate",
    "wrong_scope_modification_rate",
    "architecture_violation_rate",
    "stale_fact_usage_rate",
    "runtime_ms",
    "token_usage"
  ],
  "tasks": [
